# Cloudflare Pages headers for evewaste.com
#
# The CSP is allowlist-only: no 'unsafe-inline' and no 'unsafe-eval' anywhere.
# Every external origin below is one the site actually calls. If you add a
# provider (analytics, a new form endpoint, an embed), it will be blocked
# silently until you add it here — check the browser console first.
#
# script-src carries one sha256 hash. That is the inline one-liner in every
# page's <head>:
#
#     <script>document.documentElement.classList.add('js');</script>
#
# It marks that scripting is live so the scroll-reveal styles can apply. If you
# edit that line by even one character the hash stops matching, the script is
# blocked, and every .fade-up section stays in its visible resting state —
# degraded, but never blank. Recompute with:
#
#     printf "%s" "document.documentElement.classList.add('js');" \
#       | openssl dgst -sha256 -binary | openssl base64
#
# JSON-LD blocks are type="application/ld+json"; browsers treat those as data,
# not executable script, so they need no hash.

/*
  # Umami is allowlisted below for Umami Cloud (cloud.umami.is). IF YOU SELF-HOST
  # UMAMI, replace both cloud.umami.is entries with your own instance's origin —
  # the script will be blocked otherwise, silently, with only a console error.
  # style-src and font-src are 'self' only: Archivo is self-hosted from
  # assets/fonts/, so fonts.googleapis.com and fonts.gstatic.com are gone from
  # the policy entirely. Do not re-add a Google Fonts <link> without adding them
  # back here AND adding Google to the privacy policy - the font request
  # discloses every visitor's IP.
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' https://cloud.umami.is; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.web3forms.com https://script.google.com https://script.googleusercontent.com https://cloud.umami.is https://api-gateway.umami.dev; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  # HSTS is deliberately short and scoped to the apex for launch. A browser that
  # sees this refuses plain HTTP for the covered hosts until it expires, and you
  # cannot call it back — so ramp it rather than starting at a year:
  #   1. launch at 86400 (one day), confirm every page and asset loads over HTTPS
  #   2. after a week clean, raise to 31536000
  #   3. only then add `includeSubDomains`, and only once EVERY subdomain you use
  #      (mail, staging, anything) can serve HTTPS - it applies to all of them
  #   4. `preload` is a separate, much harder-to-reverse commitment. Not set.
  Strict-Transport-Security: max-age=86400

# Images and static assets carry their size or purpose in the filename
# (ad-system-prototype-1280.avif, favicon-32.png), so a new version is a new
# name. Safe to cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS are referenced with a content hash in the query string
# (css/styles.css?v=d2a939e5), written by `npm run stamp`. The URL changes
# whenever the file's bytes change, so caching them hard is safe: a returning
# visitor asks for a URL they have never seen and gets the new file.
#
# THIS DEPENDS ON THE STAMP BEING CURRENT. Run `npm run stamp` (or `npm run
# build`) after editing anything in css/ or js/ and before deploying. Skip it
# and returning visitors keep the old file for a year.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must not be cached hard, or a content fix will not reach anyone.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Discovery files change independently of a deploy.
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600
